# Postgres connection string. For Supabase use the "Session pooler" URI
# (Project Settings > Database > Connection string), with sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transit

# API key from https://api-manager.opentransportdata.swiss/ (GTFS-RT product).
OTD_API_KEY=

# Optional: key for the CKAN catalogue API if it is a separate subscription (defaults to OTD_API_KEY).
OTD_CKAN_API_KEY=

# Sent with every request; the opentransportdata.swiss API rejects requests without one.
STA_USER_AGENT=swiss-transit-analytics/0.1 (+https://github.com/<you>/swiss-transit-analytics)
